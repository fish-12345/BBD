package io.github.romanvht.byedpi.ui.viewmodel

import android.app.Application
import androidx.compose.runtime.getValue
import androidx.compose.runtime.mutableIntStateOf
import androidx.compose.runtime.mutableStateListOf
import androidx.compose.runtime.mutableStateOf
import androidx.compose.runtime.setValue
import androidx.compose.runtime.snapshotFlow
import androidx.lifecycle.AndroidViewModel
import androidx.lifecycle.viewModelScope
import io.github.romanvht.byedpi.core.ByeDpiProxy
import io.github.romanvht.byedpi.data.AppStatus
import io.github.romanvht.byedpi.services.appStatus
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.Job
import kotlinx.coroutines.delay
import kotlinx.coroutines.flow.collect
import kotlinx.coroutines.flow.distinctUntilChanged
import kotlinx.coroutines.isActive
import kotlinx.coroutines.launch
import kotlinx.coroutines.withContext

enum class ConnectionState { Started, Desync, Closed, Timeout, Error }

data class ConnectionEvent(
    val id: Long,
    val time: String,
    val host: String,
    val destination: String,
    val state: ConnectionState,
    val detail: String? = null,
    val received: Long? = null
)

/**
 * Показывает упрощённый живой лог соединений, которые проходят через прокси.
 *
 * Данные берутся из native-буфера логов ciadpi неразрушающим чтением
 * ([ByeDpiProxy.jniPeekLogs]), поэтому «Сохранить логи» продолжает работать.
 */
class ConnectionsViewModel(application: Application) : AndroidViewModel(application) {

    val events = mutableStateListOf<ConnectionEvent>()

    var isRunning by mutableStateOf(appStatus.first == AppStatus.Running)
        private set

    var isPaused by mutableStateOf(false)
        private set

    var totalCount by mutableIntStateOf(0)
        private set

    var openCount by mutableIntStateOf(0)
        private set

    var errorCount by mutableIntStateOf(0)
        private set

    private var nextId = 0L
    private var lastTotal = 0L
    private var pendingText = ""
    private var resetBaseline = true

    private val fdToId = HashMap<Int, Long>()
    private var pollJob: Job? = null

    init {
        viewModelScope.launch {
            snapshotFlow { appStatus.first }
                .distinctUntilChanged()
                .collect { status ->
                    val running = status == AppStatus.Running
                    if (running == isRunning) return@collect
                    isRunning = running
                    if (!running) {
                        openCount = 0
                        fdToId.clear()
                        for (i in events.indices) {
                            val event = events[i]
                            if (event.state == ConnectionState.Started ||
                                event.state == ConnectionState.Desync
                            ) {
                                events[i] = event.copy(state = ConnectionState.Closed)
                            }
                        }
                    }
                }
        }
    }

    fun startMonitoring() {
        if (pollJob?.isActive == true) return
        pollJob = viewModelScope.launch {
            while (isActive) {
                if (isRunning && !isPaused) poll()
                delay(POLL_INTERVAL_MS)
            }
        }
    }

    fun stopMonitoring() {
        pollJob?.cancel()
        pollJob = null
    }

    fun togglePause() {
        isPaused = !isPaused
    }

    fun clear() {
        events.clear()
        fdToId.clear()
        totalCount = 0
        openCount = 0
        errorCount = 0
        pendingText = ""
        resetBaseline = true
    }

    override fun onCleared() {
        stopMonitoring()
        super.onCleared()
    }

    private suspend fun poll() {
        val raw = withContext(Dispatchers.IO) {
            runCatching { ByeDpiProxy.jniPeekLogs() }.getOrNull()
        } ?: return

        val sep = raw.indexOf('\n')
        if (sep <= 0) return

        val total = raw.substring(0, sep).toLongOrNull() ?: return
        val snapshot = raw.substring(sep + 1)

        if (resetBaseline) {
            resetBaseline = false
            lastTotal = total
            pendingText = ""
            return
        }

        val delta = total - lastTotal
        lastTotal = total
        if (delta <= 0L) return

        val fresh = if (delta >= snapshot.length) {
            // Буфер успел провернуться, начало неизвестно — берём весь хвост.
            pendingText = ""
            snapshot
        } else {
            snapshot.takeLast(delta.toInt())
        }

        val text = pendingText + fresh
        val lines = text.split('\n')
        pendingText = lines.last()
        lines.dropLast(1).forEach(::parseLine)
    }

    private fun parseLine(line: String) {
        val match = timestampRegex.find(line) ?: return
        val time = match.groupValues[1]
        val message = match.groupValues[2]

        when {
            message.startsWith("conn: ") -> onConn(time, message)
            message.startsWith("desync TCP: ") -> onDesync(time, message)
            message.startsWith("close: ") -> onClose(message)
            message.startsWith("timeout (") -> onTimeout(time, message)
            message.startsWith("send error: ") -> onSendError(time, message)
            message.startsWith("recv error: ") -> onRecvError(time, message)
            message.startsWith("not resolved: ") -> onNotResolved(time, message)
        }
    }

    private fun onConn(time: String, message: String) {
        val withHost = connHostRegex.find(message)
        val fd: Int
        val host: String
        val destination: String

        if (withHost != null) {
            fd = withHost.groupValues[1].toIntOrNull() ?: return
            host = withHost.groupValues[2]
            destination = withHost.groupValues[3]
        } else {
            val direct = connDirectRegex.find(message) ?: return
            fd = direct.groupValues[1].toIntOrNull() ?: return
            destination = direct.groupValues[2]
            host = destination.substringBeforeLast(':')
        }

        val event = ConnectionEvent(
            id = nextId++,
            time = time,
            host = host,
            destination = destination,
            state = ConnectionState.Started
        )
        fdToId[fd] = event.id
        totalCount++
        openCount = fdToId.size
        upsert(event, isNew = true)
    }

    private fun onDesync(time: String, message: String) {
        val match = desyncRegex.find(message) ?: return
        val fd = match.groupValues[1].toIntOrNull() ?: return
        val destination = match.groupValues[2]
        val host = match.groupValues[3].takeIf { it != "-" } ?: ""

        val id = fdToId[fd]
        if (id == null) {
            val event = ConnectionEvent(
                id = nextId++,
                time = time,
                host = host.ifBlank { destination },
                destination = destination,
                state = ConnectionState.Desync
            )
            fdToId[fd] = event.id
            totalCount++
            openCount = fdToId.size
            upsert(event, isNew = true)
            return
        }

        val event = events.firstOrNull { it.id == id } ?: return
        if (event.state == ConnectionState.Started || event.state == ConnectionState.Desync) {
            upsert(
                event.copy(
                    state = ConnectionState.Desync,
                    host = if (event.host.isBlank()) host else event.host
                ),
                isNew = false
            )
        }
    }

    private fun onClose(message: String) {
        val match = closeRegex.find(message) ?: return
        val fd = match.groupValues[1].toIntOrNull() ?: return
        val received = match.groupValues[2].toLongOrNull()

        val id = fdToId.remove(fd) ?: return
        openCount = fdToId.size

        val event = events.firstOrNull { it.id == id } ?: return
        val keepError = event.state == ConnectionState.Error || event.state == ConnectionState.Timeout
        upsert(
            event.copy(
                state = if (keepError) event.state else ConnectionState.Closed,
                received = received ?: event.received
            ),
            isNew = false
        )
    }

    private fun onTimeout(time: String, message: String) {
        val match = timeoutRegex.find(message) ?: return
        val fd = match.groupValues[2].toIntOrNull() ?: return
        markFailed(time, fd, ConnectionState.Timeout, null)
    }

    private fun onSendError(time: String, message: String) {
        val match = sendErrorRegex.find(message) ?: return
        val fd = match.groupValues[1].toIntOrNull() ?: return
        val host = match.groupValues[3]
        val error = match.groupValues[4]
        markFailed(time, fd, classifyError(error), error, host)
    }

    private fun onRecvError(time: String, message: String) {
        val match = recvErrorRegex.find(message) ?: return
        val fd = match.groupValues[1].toIntOrNull() ?: return
        val error = match.groupValues[3]
        markFailed(time, fd, classifyError(error), error)
    }

    private fun onNotResolved(time: String, message: String) {
        val match = notResolvedRegex.find(message) ?: return
        val host = match.groupValues[1].trim()
        if (host.isEmpty()) return

        val event = ConnectionEvent(
            id = nextId++,
            time = time,
            host = host,
            destination = "",
            state = ConnectionState.Error,
            detail = DETAIL_NOT_RESOLVED
        )
        totalCount++
        errorCount++
        upsert(event, isNew = true)
    }

    private fun markFailed(
        time: String,
        fd: Int,
        state: ConnectionState,
        detail: String?,
        host: String? = null
    ) {
        val id = fdToId[fd]
        if (id == null) {
            if (state == ConnectionState.Closed) return
            val event = ConnectionEvent(
                id = nextId++,
                time = time,
                host = host.orEmpty(),
                destination = "",
                state = state,
                detail = detail
            )
            totalCount++
            if (state == ConnectionState.Error) errorCount++
            upsert(event, isNew = true)
            return
        }

        val event = events.firstOrNull { it.id == id } ?: return
        if (event.state == ConnectionState.Error && state == ConnectionState.Closed) return

        if (state == ConnectionState.Error && event.state != ConnectionState.Error) {
            errorCount++
        }
        upsert(
            event.copy(
                state = state,
                detail = detail,
                host = if (event.host.isBlank()) host.orEmpty() else event.host
            ),
            isNew = false
        )
    }

    private fun upsert(event: ConnectionEvent, isNew: Boolean) {
        if (!isNew) {
            val index = events.indexOfFirst { it.id == event.id }
            if (index >= 0) {
                events[index] = event
                return
            }
        }

        events.add(0, event)
        while (events.size > MAX_EVENTS) {
            val removed = events.removeAt(events.lastIndex)
            val iterator = fdToId.entries.iterator()
            while (iterator.hasNext()) {
                if (iterator.next().value == removed.id) iterator.remove()
            }
            openCount = fdToId.size
        }
    }

    private fun classifyError(error: String): ConnectionState {
        val text = error.lowercase()
        return when {
            text.contains("reset") -> ConnectionState.Closed
            text.contains("broken pipe") -> ConnectionState.Closed
            text.contains("epipe") -> ConnectionState.Closed
            else -> ConnectionState.Error
        }
    }

    companion object {
        const val DETAIL_NOT_RESOLVED = "@not_resolved"

        private const val POLL_INTERVAL_MS = 1500L
        private const val MAX_EVENTS = 300

        private val timestampRegex = Regex("""^\d{2}-\d{2} (\d{2}:\d{2}:\d{2})\.\d{3} (.*)$""")
        private val connHostRegex = Regex("""conn: fd=(\d+) host=(.*) -> (.*)$""")
        private val connDirectRegex = Regex("""conn: fd=(\d+) -> (.*)$""")
        private val desyncRegex = Regex("""desync TCP: .*fd=(\d+), dst=(.*?), host=(.*)$""")
        private val closeRegex = Regex("""close: fd=(\d+) (?:host|addr)=.*?, recv=(-?\d+), rounds=(\d+)$""")
        private val timeoutRegex = Regex("""timeout \((\d+)\) fd=(\d+)""")
        private val sendErrorRegex = Regex("""send error: fd=(\d+), dst=(.*?), host=(.*?), err=(.*)$""")
        private val recvErrorRegex = Regex("""recv error: fd=(\d+), addr=(.*?), err=(.*)$""")
        private val notResolvedRegex = Regex("""not resolved: (.*)$""")
    }
}
